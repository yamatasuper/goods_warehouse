<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="1" author="artemmovchan">
        <createTable tableName="product">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sku" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="category" type="varchar(255)"/>
            <column name="price" type="decimal(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="last_quantity_update" type="varchar(255)"/>
            <column name="created_at" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="artemmovchan">
        <insert tableName="product">
            <column name="name" value="Laptop"/>
            <column name="sku" value="LAP12345"/>
            <column name="description" value="High-performance laptop"/>
            <column name="category" value="Electronics"/>
            <column name="price" value="999.99"/>
            <column name="quantity" value="50"/>
            <column name="last_quantity_update" value="2025-01-14"/>
            <column name="created_at" value="2025-01-01"/>
        </insert>
    </changeSet>

    <changeSet id="3" author="artemmovchan">
        <insert tableName="product">
            <column name="name" value="Smartphone"/>
            <column name="sku" value="SM12345"/>
            <column name="description" value="Latest model smartphone"/>
            <column name="category" value="Electronics"/>
            <column name="price" value="799.99"/>
            <column name="quantity" value="100"/>
            <column name="last_quantity_update" value="2025-01-14"/>
            <column name="created_at" value="2025-01-01"/>
        </insert>
    </changeSet>

    <changeSet id="4" author="artemmovchan">
        <insert tableName="product">
            <column name="name" value="Headphones"/>
            <column name="sku" value="HP12345"/>
            <column name="description" value="Wireless over-ear headphones"/>
            <column name="category" value="Accessories"/>
            <column name="price" value="199.99"/>
            <column name="quantity" value="200"/>
            <column name="last_quantity_update" value="2025-01-14"/>
            <column name="created_at" value="2025-01-01"/>
        </insert>
    </changeSet>
</databaseChangeLog>
