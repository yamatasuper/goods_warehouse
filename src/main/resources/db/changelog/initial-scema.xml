<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="202310151135" author="Maruf">
        <!-- Создание таблицы book -->
        <createTable tableName="book">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="book_id_pk" nullable="false" />
            </column>
            <column name="name" type="varchar(250)">
                <constraints nullable="false" />
            </column>
            <column name="writer" type="varchar(250)">
                <constraints nullable="false" />
            </column>
        </createTable>

        <!-- Добавление автоинкремента для колонки id -->
        <addAutoIncrement tableName="book" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1" />

        <!-- Создание последовательности (при необходимости для других операций) -->
        <createSequence sequenceName="hibernate_sequence" incrementBy="1" startValue="1" />

        <!-- Вставка данных -->
        <insert tableName="book">
            <column name="id" value="1" />
            <column name="name" value="1984" />
            <column name="writer" value="George Orwell" />
        </insert>
        <insert tableName="book">
            <column name="id" value="2" />
            <column name="name" value="To Kill a Mockingbird" />
            <column name="writer" value="Harper Lee" />
        </insert>
        <insert tableName="book">
            <column name="id" value="3" />
            <column name="name" value="The Great Gatsby" />
            <column name="writer" value="F. Scott Fitzgerald" />
        </insert>
        <insert tableName="book">
            <column name="id" value="4" />
            <column name="name" value="Pride and Prejudice" />
            <column name="writer" value="Jane Austen" />
        </insert>
    </changeSet>
</databaseChangeLog>
